try:
    a=int(input("введите первое число: "))
    b=int(input("введите второе число: "))
    c=int(input(f"Выберите действие: \n 1)сложить\n 2)отнять\n 3)умножить\n 4)делить\n 5)найти остаток от деления\n 6)возвести в степень\n 7)целочисленное деление\n"))
    if c ==1:
        print(f"сумма: {a+b}")
    elif c==2:
        print(f"разность: {a-b}")
    elif c==3:
        print(f"произведение: {a*b}")
    elif c==4:
        (f"частное: {a/b}")
    elif c==5:
        print(f"остаток от деления: {a%b}")
    elif c==6:
        print(a**b)
    elif c ==7:
        print(a//b)
    else:
        print("попробуй еще раз")
except:
    print("это не число, повторите попытку")
